{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Append-only evidence-v1 adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "run_id",
    "job_id",
    "repetition",
    "question_id",
    "status",
    "disposition",
    "evidence_refs",
    "reviewers",
    "rationale",
    "supersedes"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "disposition": {
      "enum": [
        "JEV_ERROR",
        "ORACLE_AMBIGUITY",
        "QUESTION_DEFECT",
        "EVIDENCE_TRANSLATION_DEFECT",
        "CONSTRUCT_AMBIGUITY",
        "INSUFFICIENT_EVIDENCE",
        "UNRESOLVED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewers": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "blind_notes",
          "reconciliation"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "blind_notes": {
            "type": "string",
            "minLength": 1
          },
          "reconciliation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rationale": {
      "type": "string"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "closed"
          }
        }
      },
      "then": {
        "properties": {
          "reviewers": {
            "minItems": 2,
            "uniqueItems": true
          },
          "rationale": {
            "minLength": 1
          },
          "disposition": {
            "not": {
              "const": "UNRESOLVED"
            }
          }
        }
      }
    }
  ]
}
